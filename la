#Script para usar "la", en vez de "ls -la"
#Muestra directorios con / al final -> directorio/
#Muestra orden alfabético, primero carpetas, luego ficheros.

if [ $# == 0 ]; then
    ls -lh -F --group-directories-first --color=always
else
    ls -lh -F --group-directories-first --color=always "$@"
    #  $*  > Añade los argumentos uno a uno separados por espacios.
    #            ./en\ ello/ ./plantillas/ => ./en ello/ ./plantillas (3 args)
    # "$*" > Convierte todos argumentos en 1 solo string separado por espacios.
    #            ./en\ ello/ ./plantillas/ => "./en ello/ ./plantillas" (1 arg)
    #  $@  > Igual que $*
    # "$@" > Cada argumento se convete en una palabra independiente.
    #            ./en\ ello/ ./plantillas/ => "./en ello/" "./plantillas" (2 args)
fi
